# Environment: dev | prod
CLAIMCRAFT_APP_ENV=dev

# Optional explicit override. If omitted, defaults come from APP_ENV.
# CLAIMCRAFT_PRICING_SERVICE_BASE_URL=http://127.0.0.1:8080

# Environment-specific defaults
CLAIMCRAFT_PRICING_SERVICE_BASE_URL_DEV=http://127.0.0.1:8080
CLAIMCRAFT_PRICING_SERVICE_BASE_URL_PROD=http://pricing-gateway:8080

# Outbound HTTP settings
CLAIMCRAFT_PRICING_SERVICE_TIMEOUT_SECONDS=10
CLAIMCRAFT_PRICING_SERVICE_RETRY_TOTAL=3
CLAIMCRAFT_PRICING_SERVICE_RETRY_BACKOFF_SECONDS=0.5
# JSON array string
CLAIMCRAFT_PRICING_SERVICE_RETRY_STATUSES=[429,500,502,503,504]

# Logging
CLAIMCRAFT_LOG_LEVEL=INFO
CLAIMCRAFT_LOG_JSON=true
